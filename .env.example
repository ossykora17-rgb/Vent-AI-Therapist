# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. On Vercel, add these under
# Project -> Settings -> Environment Variables (Production + Preview).
# The app builds and boots without any of them; features stay disabled.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# dashboard.paystack.com -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Canonical origin for auth redirects. Leave blank on Vercel: VERCEL_URL is
# used automatically. Set this to your custom domain once you have one.
NEXT_PUBLIC_SITE_URL=

# Perspective (Google) -> the Guardian's second opinion on a circle message.
# Free tier is 1,000 requests/day. Without it the local rules still run and
# the Guardian passes everything they allow — fail-open, by design.
PERSPECTIVE_API_KEY=

# LiveKit -> Phase 1 voice. The server mints tokens with no dependency; the
# browser half needs `livekit-client` and is not built yet.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sugra -> commodities and market data. Optional: the exchange rate works
# without it, and no source here is ever required for the product to run.
SUGRA_API_KEY=

# Point this at a directory of recorded upstream shapes to run the external
# integrations with no network (scripts/fixtures/external). Never set in
# production — it makes the app serve recorded data instead of real data.
VENT_EXTERNAL_FIXTURE=
